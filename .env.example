# ─────────────────────────────────────────────
#  Synapse RPC (OOBE Protocol)
#  Get your key: https://synapse.oobeprotocol.ai/dashboard (free tier)
#  Format: https://us-1-mainnet.oobeprotocol.ai/rpc?api_key=sk_...
# ─────────────────────────────────────────────
SAP_API_KEY=your_synapse_api_key_here
SYNAPSE_RPC_URL=https://api.mainnet-beta.solana.com

# ─────────────────────────────────────────────
#  Ace Data Cloud
#  Sign up (free credits): https://platform.acedata.cloud
# ─────────────────────────────────────────────
ACE_API_KEY=your_ace_data_cloud_api_key_here
ACE_BASE_URL=https://api.acedata.cloud

# ─────────────────────────────────────────────
#  Solana Wallet (for live x402 payments)
#  Base58 private key of your funded wallet
# ─────────────────────────────────────────────
SOLANA_PRIVATE_KEY=your_base58_private_key_here
SOLANA_WALLET_PUBKEY=your_wallet_public_key_here
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─────────────────────────────────────────────
#  Agent Config
# ─────────────────────────────────────────────
AGENT_NAME=ResearchBot-v1

# ─────────────────────────────────────────────
#  x402 Payment Mode
#  Set to "false" + add SOLANA_PRIVATE_KEY for live on-chain payments
#  Keep "true" for demo/dry-run mode (no wallet needed)
# ─────────────────────────────────────────────
X402_DRY_RUN=true
X402_NETWORK=solana

# ─────────────────────────────────────────────
#  Event Watcher
# ─────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
MIN_RUN_GAP_MINUTES=30

# ─────────────────────────────────────────────
#  Optional: Telegram bot
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
